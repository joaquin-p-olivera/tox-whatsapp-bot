# Runtime environment. Only read from the real process environment (not from this file):
# `npm start` reads .env, `npm run start:prod` sets APP_ENV=prod and reads .env.prod.

# --- Tox API ---
TOX_API_URL=http://127.0.0.1:8000
# Same secret as API_KEY in the tox API's .env
TOX_API_KEY=
TOX_API_TIMEOUT_MS=10000

# --- WhatsApp account (the dedicated chip) ---
# Number of the WhatsApp account the bot runs on, with country code (e.g. +598XXXXXXXX). Used to request the
# 8-character pairing code the first time (WhatsApp > Linked devices > Link with phone number).
BOT_PHONE_NUMBER=
# Stable session name: changing it forces a new pairing.
BOT_SESSION_ID=tox
# Where the session (SQLite) is stored. Keep it private: it holds the account's keys.
AUTH_DIR=.auth

# --- Access control ---
# Comma-separated group JIDs the bot answers in (e.g. 120363012345678901@g.us).
# Empty = answer in every group. Send !whoami in a group to discover its JID.
ALLOWED_GROUP_JIDS=
# Whether to answer in private (1:1) chats
ALLOW_PRIVATE_CHATS=false

# --- Misc ---
# Only messages starting with one of these are forwarded to the API
COMMAND_PREFIXES=!,/
# trace, debug, info, warn, error
LOG_LEVEL=info
